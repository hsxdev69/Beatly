# Echo Music Development Environment Configuration

# API Base URL for stream resolution and search proxy
# Web browser / Localhost:
API_BASE_URL=http://localhost:8080

# Android Emulator:
# API_BASE_URL=http://10.0.2.2:8080

# Physical Android Phone on same Wi-Fi:
# API_BASE_URL=http://192.168.1.100:8080

# External APIs
MUSIC_API_URL=https://itunes.apple.com/search
LYRICS_API_URL=https://lrclib.net/api/search
